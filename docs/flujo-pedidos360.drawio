<mxfile host="app.diagrams.net" modified="2026-10-20T12:00:00.000Z" agent="Claude Code" version="24.0.0" type="device">
  <diagram name="Arquitectura Pedidos360" id="arq-ea2">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Pedidos360 &#8212; Autenticacion, API Gateway, microservicios y mensajeria RabbitMQ" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Lineas solidas = peticiones y mensajes. Lineas punteadas = validacion del JWT (JWKS de Azure AD) y rutas de error (DLQ)." style="text;html=1;fontSize=12;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="1100" height="20" as="geometry" />
        </mxCell>

        <!-- Identidad -->
        <mxCell id="azuread" value="Azure AD (Entra ID)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;IDaaS &#8226; OAuth 2.0 / OIDC &#8226; App Roles: Admin, Operador, Cliente, Auditor&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="330" y="110" width="330" height="70" as="geometry" />
        </mxCell>

        <!-- Cliente y gateway -->
        <mxCell id="user" value="Usuario&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Cliente / Operador / Admin&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="30" y="430" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="frontend" value="Frontend Angular&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;MSAL &#8226; :4200&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="230" y="430" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gateway" value="AWS API Gateway&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;HTTP API + JWT Authorizer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="450" y="430" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="bff" value="ms-pedidos360-bff&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Valida JWT + enruta &#8226; :8080&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="680" y="430" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Microservicios -->
        <mxCell id="orders" value="ms-pedidos360-orders&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Pedidos y estados &#8226; PRODUCTOR &#8226; :8081&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="940" y="230" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="catalog" value="ms-pedidos360-catalog&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Productos y stock &#8226; :8082&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="940" y="340" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mqadmin" value="ms-pedidos360-mqadmin&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Administrador RabbitMQ &#8226; solo Admin &#8226; :8083&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="940" y="450" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="notify" value="ms-pedidos360-notify&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;CONSUMIDOR &#8226; ACK manual &#8226; listener de DLQ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="940" y="760" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- Bases de datos -->
        <mxCell id="ordersdb" value="pedidos360_orders" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1230" y="225" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="catalogdb" value="pedidos360_catalog" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1230" y="335" width="140" height="70" as="geometry" />
        </mxCell>

        <!-- Cluster RabbitMQ -->
        <mxCell id="cluster" value="Cluster RabbitMQ &#8212; EC2 + Docker Compose (rabbit1:5672/15672 &#183; rabbit2:5673/15673)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="1230" y="460" width="650" height="400" as="geometry" />
        </mxCell>
        <mxCell id="exch" value="Exchanges&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;cmd.direct (direct) &#183; cmd.topic (topic)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="cluster">
          <mxGeometry x="20" y="60" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="queues" value="Colas principales&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;q.cmd.email &#183; q.cmd.kitchen &#183; q.cmd.invoice&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="cluster">
          <mxGeometry x="260" y="60" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dlx" value="cmd.dead.dlx (direct)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;dead-letter exchange&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="cluster">
          <mxGeometry x="260" y="190" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="dlqs" value="DLQ&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;q.cmd.email.dlq &#183; q.cmd.kitchen.dlq &#183; q.cmd.invoice.dlq&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="cluster">
          <mxGeometry x="260" y="300" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="policies" value="Politicas de retencion&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;max-length &#183; max-length-bytes &#183; message-ttl&lt;br&gt;(24 h colas, 7 dias DLQ)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;" vertex="1" parent="cluster">
          <mxGeometry x="470" y="60" width="160" height="90" as="geometry" />
        </mxCell>

        <!-- Flujo de autenticacion y peticiones -->
        <mxCell id="e1" value="1. Abre la app" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="frontend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="2. Login OIDC (loginRedirect)&#10;y tokens (ID + access, con roles)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="frontend" target="azuread">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="310" y="145" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e3" value="3. Authorization: Bearer &lt;token&gt;&#10;(MsalInterceptor)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="frontend" target="gateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="4. Valida JWT&#10;(issuer, audience, firma)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="gateway" target="azuread">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="535" y="300" />
              <mxPoint x="495" y="300" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e5" value="5. Ruta /api/**" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gateway" target="bff">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6a" value="/api/orders" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="1" source="bff" target="orders">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6b" value="/api/catalog" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="bff" target="catalog">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6c" value="/api/admin (solo Admin)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;entryX=0;entryY=0.5;" edge="1" parent="1" source="bff" target="mqadmin">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="Al aceptar: descuenta stock (REST)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="orders" target="catalog">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8a" value="Persiste" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="orders" target="ordersdb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8b" value="Persiste" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="catalog" target="catalogdb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Mensajeria -->
        <mxCell id="m1" value="Publica comandos DESPUES del commit&#10;(EmailSend, KitchenTicket, InvoiceGen)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="orders" target="exch">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1190" y="260" />
              <mxPoint x="1190" y="440" />
              <mxPoint x="1345" y="440" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m2" value="bindings&#10;(clave exacta / patron)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="exch" target="queues">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="NACK sin reintento&#10;(inv&#225;lido / no recuperable / vencido)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="queues" target="dlx">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="routing key" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="dlx" target="dlqs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m5" value="Consume con ACK manual&#10;(1 reintento, luego DLQ)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="queues" target="notify">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1450" y="780" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m6" value="Listener de DLQ:&#10;log (origen, motivo x-death) + ACK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.75;" edge="1" parent="1" source="dlqs" target="notify">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1200" y="795" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m7" value="Crea / elimina colas,&#10;exchanges y bindings" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.25;" edge="1" parent="1" source="mqadmin" target="cluster">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1200" y="480" />
              <mxPoint x="1200" y="560" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="legend" value="Pendiente fuera de este alcance: Kafka (auditoria y reporteria) y ms-pedidos360-audit / ms-pedidos360-report." style="text;html=1;fontSize=11;fontColor=#999999;align=left;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1">
